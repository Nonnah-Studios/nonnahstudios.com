{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Next.js 静态导出 (out/) 作为 Worker 静态资源托管
  "name": "nonnahstudios",
  "compatibility_date": "2026-11-01",
  // 账号 ID 不是凭据，可以公开；部署凭据是 CI 里的 CLOUDFLARE_API_TOKEN secret
  "account_id": "b5f0961d7c60650f2924a68edc432dfd",
  // 只负责给 /media/ 下的视频补 Range(206) 支持，其余请求不经过脚本
  "main": "worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/media/*"]
  },
  // 绑定自定义域名（自动创建 DNS 记录和证书）
  "routes": [
    { "pattern": "nonnahstudios.com", "custom_domain": true }
  ]
}
